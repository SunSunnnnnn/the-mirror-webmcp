{
  "name": "search_works",
  "status": "public_sample_mvp",
  "read_only": true,
  "purpose": "Search anonymized real-case judgment evidence by visitor concern. Similarity never implies technical replicability.",
  "input_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Search Public Judgment Evidence",
    "type": "object",
    "additionalProperties": false,
    "required": ["concerns"],
    "properties": {
      "concerns": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "enum": ["low_maintenance", "long_return_interval", "work_visibility_constraint", "private_public_identity_conflict", "fear_of_yellow_or_orange_fade", "self_reported_old_bleach_history", "self_reported_damaged_hair_constraint", "grow_out_concern", "strong_expression", "hidden_expression", "experimental_openness", "previous_work_as_material", "constraint_transformed_into_design"]}},
      "free_text_concern": {"type": ["string", "null"], "description": "Consultation background, not physical diagnosis."},
      "visual_preferences": {"type": "array", "items": {"type": "string"}},
      "limit": {"type": "integer", "minimum": 1, "maximum": 4, "default": 3}
    }
  },
  "output_schema": {"type": "object", "required": ["matches", "requires_in_person_assessment", "what_cannot_be_concluded_remotely"]}
}
